---
const { title, description, canonical } = Astro.props;
const url = canonical ? `https://whatswattworth.com${canonical}` : undefined;
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{url && <link rel="canonical" href={url}>}
<link rel="stylesheet" href="/styles.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%23e8a317'/></svg>">
</head>
<body>
<header class="site"><div class="wrap">
<a class="logo" href="/">Whats<span>Watt</span>Worth</a>
<nav><a href="/solar">Solar by area</a><a href="/about">About</a><a href="/methodology">Methodology</a><a href="/privacy">Privacy</a></nav>
</div></header>
<slot />
<footer class="site"><div class="wrap">
<p><a href="/about">About</a><a href="/methodology">Methodology</a><a href="/privacy">Privacy</a><a href="/disclosure">Affiliate disclosure</a></p>
<p>Contact: <a href="mailto:hello@whatswattworth.com">hello@whatswattworth.com</a></p>
<p>Some links on this site may be affiliate links. If you request a quote or buy through them we may earn a commission, at no extra cost to you. It never changes the data we show.</p>
<p>&copy; 2026 WhatsWattWorth. Independent UK publisher. Not affiliated with MCS, Ofgem or any government department.</p>
</div></footer>
</body>
</html>
