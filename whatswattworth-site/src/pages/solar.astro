---
import Base from '../layouts/Base.astro';
import { loadAreas, median, fmt } from '../data';
const areas = loadAreas().filter(a => a.kwh !== null);
const sorted = [...areas].sort((a, b) => b.kwh! - a.kwh!);
const top = sorted.slice(0, 10), bottom = sorted.slice(-10).reverse();
const med = median(areas.map(a => a.kwh!));
const all = [...areas].sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Solar panel output by UK local authority | WhatsWattWorth" description="Estimated yearly solar generation for every UK local authority, ranked from sunniest to least sunny, using the EU's PVGIS model." canonical="/solar">
<main class="page"><div class="wrap">
<h1>Solar panel output by UK local authority</h1>
<p class="lede">We estimate how much electricity a standard 1 kW south-facing solar system would generate in each of {areas.length} local authorities. The UK median is {fmt(Math.round(med))} kWh per kW per year.</p>
<h2>Highest-output areas</h2>
<ol>{top.map(a => <li><a href={`/solar/${a.slug}`}>{a.name}</a>: {fmt(a.kwh!)} kWh/kW/year</li>)}</ol>
<h2>Lowest-output areas</h2>
<ol>{bottom.map(a => <li><a href={`/solar/${a.slug}`}>{a.name}</a>: {fmt(a.kwh!)} kWh/kW/year</li>)}</ol>
<h2>All areas</h2>
<ul style="columns:2;column-gap:24px;list-style:none;padding:0">{all.map(a => <li style="margin-bottom:6px"><a href={`/solar/${a.slug}`}>{a.name}</a></li>)}</ul>
</div></main>
</Base>
